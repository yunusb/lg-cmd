{
  "expo": {
    "name": "LG Remote",
    "slug": "lg-cmd",
    "scheme": "lgcmd",
    "version": "1.2.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.yunusb.lgcmd",
      "versionCode": 4,
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.TRANSMIT_IR",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ]
    },
    "plugins": [
      "./plugins/withCleartextForLocalWebOS",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "d4c12bb7-ce55-478f-a5b7-b519275a775f"
      }
    }
  }
}
